        presSea = 760.00;                                                                 // переменной для формулы расчета высоты присваивается начальное значение
        presTMP = 760.00;                                                                 // временной переменной давления присваивается начальное значение
        s0 = '7';                                                                         // посимвольное присвоение строкам начальных значений давления
        s1 = '6';                                                                         // посимвольное присвоение строкам начальных значений давления
        s2 = '0';                                                                         // посимвольное присвоение строкам начальных значений давления
        s3 = '0';                                                                         // посимвольное присвоение строкам начальных значений давления
        s4 = '0';                                                                         // посимвольное присвоение строкам начальных значений давления
        altSEATmp = 0;                                                                    // обнуление корректируемой высоты (нужно, что бы, при ранее обнулённой высоте у моря, значение вернулось к расчетному по давлению)
