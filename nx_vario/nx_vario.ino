///// ВЫВОД ЭКРАНА ТРЕВОГИ / ALARM SCREEN OUTPUT /////
else                                                                    // ОТОБРАЖЕНИЕ ЭКРАНА ТРЕВОГИ
{                                                                       //
  if ((altitude-altdif)>=100)                                           // Если высота больше или равна 100 метрам, то просто предупреждаем о ПАДЕНИИ
