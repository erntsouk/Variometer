///// ГЛАВНЫЙ ЦИКЛ / MAIN CYCLE /////
void loop()                                                                               //
{                                                                                         //
if (sensor.read(3))                                                                       // проверка на наличие данных с датчика 
{                                                                                         // чтение параметров с датчика bmp180. в скобках могут быть значения чувствительности от 0 до 3. 3 - максимум 
if (vario>-0.3) {Alarm = false;}                                                          // проверка ВКЛ/ВЫКЛ сигнала тревоги при падении

///// ОБРАБОТКА СОБЫТИЙ НА КНОПКЕ 1 / BUTTON 1 SHORT PRESS /////
if ((b1.update() == 1) && (b1.read() == HIGH) && (b1.rose() == 1) && (longpress == false))   // если зарегистрировано событие и КНОПКА 1 нажата и не было зарегистрировано длительное нажатие (короче, это короткий клик)
  {                                                                                       //
    button_beep();                                                                        // сигнал при нажатии клавиши
    if (MainMenu == false)                                                                // ... и если мы не в МЕНЮ ...
      {                                                                                   //
        MainMenu = true;                                                                  // то включается режим меню
          s0 = presSTR[0];                                                                // присваиваем строке s0 первый символ в значении давления
          s1 = presSTR[1];                                                                // присваиваем строке s1 второй символ в значении давления
          s2 = presSTR[2];                                                                // присваиваем строке s2 третий символ в значении давления
          s3 = presSTR[4];                                                                // присваиваем строке s3 четвертый символ в значении давления
          s4 = presSTR[5];                                                                // присваиваем строке s4 пятый символ в значении давления
        beep_ON = false;                                                                  // выключаем флаг beep_ON (то есть, в МЕНЮ не работает звук вариометра)
        lcd.clear();                                                                      // очистка экрана при нажатии кнопки
      }                                                                                   //
    else                                                                                  // ... если мы, всё-таки, в МЕНЮ, то по короткому нажатию на клавишу 1...
      {                                                                                   //
        MainMenu = false;                                                                 // выключаем меню
        menuCount = 0;                                                                    // обнуляем счётчик режимов меню, что бы при каждом входе в меню, первое окно всегда было первым
        symCount = 0;                                                                     // обнуляем счётчик символов, что бы при входе в режим редактирования, первым выбирался первый символ                                                                      
        if (presChange == true)                                                           // если выход из меню производится при активном режиме ввода символов, то...
          {                                                                               //
            presChange = false;                                                           // ... выключаем режим ввода и...
            presTMP = presSea;                                                            // ... присваиваем временной переменной давления значение дефолтного давления и...
            if ((presTMP>=100)) {presSTR = (String)presTMP;}                              // Проверка, если значение давления меньше 100 или 10, то необходимо добить спереди строки недостающие ноли, иначе не будет корректно работать изменение. Тут просто присваиваем значение, т.к. >=100
            else if ((presTMP<100)&&(presTMP>=10)) {presSTR = (String)"0"+presTMP;}       // если от 10 до 100, то прибавляем один ноль в начале строки
            else if ((presTMP<10)&&(presTMP>=0)) {presSTR = (String)"00"+presTMP;}        // если от 0 до 10, то прибавляем два ноля в начале строки
          }                                                                               //
        beep_ON = true;                                                                   // включаем обратно флаг beep_ON, что бы при выходе из меню возобновился звук вариометра
        lcd.clear();                                                                      // очистка экрана при нажатии кнопки
      }                                                                                   //
  }                                                                                       //

///// ДЛИННОЕ НАЖАТИЕ КНОПКИ 1 / BUTTON 1 LONG PRESS /////
if (Buttom1.click())                                                                      // если кнопка 1 зажата больше 1 секунды, то... (это длинный клик)
  {                                                                                       //
    long_beep();                                                                          // длинный бип
    if (MainMenu == false)                                                                // ... и если мы не в МЕНЮ ...
      {                                                                                   //
        lcd.setCursor(13,0);                                                              // ОБНУЛЯЕМ ВРЕМЯ по длительному нажатию КЛАВИШИ 1
        lcd.print("   ");                                                                 // затираем старое значение времени
        timeZero = millis();                                                              // присвоение значения переменной для обнуления времени      
      }                                                                                   // 
    else                                                                                  // ... если мы, всё-таки, в МЕНЮ, то по длинному нажатию на клавишу 1...
      {                                                                                   //

      }                                                                                   //
    longpress = true;                                                                     // переменной присваивается true, т.е. факт длительного нажатия
  }                                                                                       //
if (b1.fell() == 1) {longpress = false;}                                                  // убираем факт длительного нажатия при отпускании книпки
Buttom1.release();                                                                        // обязательно надо прописывать после выполнения click(), иначе выполнится только раз

///// ОБРАБОТКА СОБЫТИЙ НА КНОПКЕ 2 / BUTTON 2 SHORT PRESS /////
if ((b2.update() == 1) && (b2.read() == HIGH) && (b2.rose() == 1) && (longpress == false))   // если зарегистрировано событие и КНОПКА 2 нажата и не было зарегистрировано длительное нажатие (короткий клик)
  {                                                                                       //
    button_beep();                                                                        // сигнал при нажатии клавиши
    lcd.clear();                                                                          // очистка экрана при нажатии кнопки
    if (MainMenu == false)                                                                // ... и если мы не в МЕНЮ ...
      {                                                                                   // 
        if (windowCount == 0)                                                             // если мы в первом главном экране
          {                                                                               //
            cnt+=1;                                                                       // увеличиваем значение счётчика на единицу
            if (cnt==7)                                                                   // если значение счётчика дошло до 7, то...
              {                                                                           // ... присваиваем ему значение 4
                cnt=4;                                                                    // используются значения от 4 до 6, поскольку номера символов высоты идут от 4 до 6
              }                                                                           //
          }                                                                               //
      }                                                                                   //
    else                                                                                  // ... если мы, всё-таки, в МЕНЮ, то по короткому нажатию на клавишу 2...
      {                                                                                   //
        if (presChange == false)                                                          // если ВЫКЛЮЧЕН режим ввода символов для давления по морю...
          {                                                                               //
            menuCount += 1;                                                               // ...выбор окна меню
            if (menuCount == 10) {menuCount = 0;}                                         // если счётчик больше десяти, то присваиваем 0, т.е. первый экран меню
          }                                                                               //
        else                                                                              // если ВКЛЮЧЕН режим редактирования давления, то...
          {                                                                               //
            symCount += 1;                                                                // увеличиваем счётчик выбранного символа (до четвертого символа) на 1
            if (symCount == 3) {symCount += 1;}                                           // с четвертого начинаем прибавлять дополнительную единицу, что бы перескочить запятую
            if (symCount == 6) {symCount = 0;}                                            // если счетчик дошел до 7 символа, то обнуляем (т.к. в нашем float шесть символов)
          }                                                                               // 
      }                                                                                   // 
  }                                                                                       // 

///// ДЛИННОЕ НАЖАТИЕ КНОПКИ 2 / BUTTON 2 LONG PRESS /////
if (Buttom2.click())                                                                      // если кнопка 2 зажата больше 1 секунды, то... (длинный клик)
  {                                                                                       // 
    SSL_beep();                                                                           // вызов функции КОРОТКОГО-КОРОТКОГО-ДЛИННОГО ПИСКА
    if (MainMenu == false)                                                                // ... и если мы не в МЕНЮ ...
      {                                                                                   // ОБНУЛЕНИЕ ВЫСОТ ДЛИННЫМ НАЖАТИЕМ КНИПКИ 2
