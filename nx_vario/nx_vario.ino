    lcd.write(byte(6)); lcd.print(" "+String(maxAltAdd)+"m");                           // рисуем значение максимальной дополнительной высоты
  }                                                                                     //

///// ГЛАВНОЕ ОКНО 3 / MAIN WINDOW 3 (Max/Min vario) /////
if (windowCount == 2)                                                   // если выбран третий экран меню
  {                                                                     //
    lcd.setCursor(0,0);                                                 //
